        { "id": "search-terms", "label": "Ricerche lavoro", "type": "text", "default": "badante part time", "help": "Ogni termine viene combinato con ciascuna zona. Puoi aggiungere assistente familiare part time." },
        { "id": "interval-seconds", "label": "Intervallo fra cicli (secondi)", "type": "number", "default": 1800, "min": 60, "step": 60, "help": "1800 = ogni 30 minuti. Il primo controllo parte subito." },
