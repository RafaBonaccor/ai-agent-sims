        { "id": "include-details", "label": "Apri annunci per descrizione completa", "type": "checkbox", "default": false, "emitFalseFlag": true, "help": "Più preciso ma più lento; normalmente i dati della lista sono sufficienti." },
        { "id": "db-path", "label": "Database storico", "type": "text", "default": "data/subito_jobs.db", "help": "Database separato: non modifica il database o le logiche Vinted." },
