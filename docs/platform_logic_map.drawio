  <diagram id="scheduler-cron-visibility" name="Scheduler &amp; Cron Visibility">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s-title" value="Visibilità scheduler, cron e job ricorrenti" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s-subtitle" value="Questa pagina mostra cosa gira automaticamente, cosa può essere pianificato, dove si vede lo stato e quali controlli servono per evitare job zombie o duplicati." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#667085;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="42" y="78" width="980" height="48" as="geometry" />
        </mxCell>

        <mxCell id="runtime-box" value="Runtime scheduler&#xa;&#xa;Primitive comune che crea timer, attende date future, cron o ripetizioni e poi accoda il job/ task." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#2563EB;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gateway-box" value="Project Gateway&#xa;&#xa;Riceve azioni dal gioco, Discord o preset. Decide: run immediato, scheduled, cron, repeat." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="170" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="jobs-box" value="Jobs active / notifications&#xa;&#xa;Vista operativa: running, scheduled, failed, completed, stop button, output e alert associati." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F2;strokeColor=#0F9F6E;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="170" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="discord-box" value="Discord bridge&#xa;&#xa;Può avviare job, ricevere report, ricevere errori e mostrare completamenti o blocchi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#D92D20;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1100" y="170" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="memory-box" value="Memory / context jobs&#xa;&#xa;Job periodici interni: manutenzione wiki, consigli tra agenti, proposta miglioramenti e riepiloghi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#B7791F;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1450" y="170" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2563EB;endArrow=block;" edge="1" parent="1" source="runtime-box" target="gateway-box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7C3AED;endArrow=block;" edge="1" parent="1" source="gateway-box" target="jobs-box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#0F9F6E;endArrow=block;" edge="1" parent="1" source="jobs-box" target="discord-box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B7791F;endArrow=block;dashed=1;" edge="1" parent="1" source="memory-box" target="jobs-box"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="table-title" value="Inventario job schedulabili / ricorrenti" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="jt-head" value="Job | Trigger | Frequenza | Dove si vede | Stop / controllo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101828;strokeColor=#101828;fontColor=#FFFFFF;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="395" width="1540" height="38" as="geometry" />
        </mxCell>
        <mxCell id="jt-profile" value="Monitor profili piattaforma | Start manuale, preset o Discord | Primo controllo immediato, poi intervallo scelto | Jobs active, notifications, Discord report | Stop job; timeout disattivato; protezione snapshot incompleto" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#CBD5E1;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="433" width="1540" height="54" as="geometry" />
        </mxCell>
        <mxCell id="jt-deal" value="Procacciatore affari | Start manuale da gateway o GUI | Loop interno con pausa configurabile | Tabella risultati, Discord, job output | Stop job; deduplica articoli; può continuare mentre invii offerte" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F2;strokeColor=#CBD5E1;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="487" width="1540" height="54" as="geometry" />
        </mxCell>
        <mxCell id="jt-ai-news" value="Briefing mattutino AI | Scheduler interno all'avvio runtime | Giornaliero, orario configurato | Notifiche gioco, task agent, logs runtime | Può essere testato subito; modello deve supportare strumenti web" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#CBD5E1;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="541" width="1540" height="54" as="geometry" />
        </mxCell>
        <mxCell id="jt-project-cron" value="Project job cron | Project Gateway schedule mode = cron | Espressione cron a 5 campi | Job history + scheduled state | Validazione cron; prossimo run calcolato dal runtime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#CBD5E1;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="595" width="1540" height="54" as="geometry" />
        </mxCell>
        <mxCell id="jt-project-repeat" value="Project job repeat | Project Gateway schedule mode = at + repeat | once, daily, weekdays | Job history, scheduled_for, repeat_mode | Dopo completamento pianifica follow-up se richiesto" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#CBD5E1;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="649" width="1540" height="54" as="geometry" />
        </mxCell>
        <mxCell id="jt-memory" value="Memory maintenance / council | Trigger manuale o schedulato interno | Periodico/occasionale | Memory Core, wiki proposals, agent chat bubbles | Deve mostrare conversazioni e proposte, non girare invisibile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#CBD5E1;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="703" width="1540" height="54" as="geometry" />
        </mxCell>

        <mxCell id="visibility-title" value="Cosa deve essere visibile nel gioco" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="815" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="vis1" value="Scheduler dashboard&#xa;&#xa;Lista di job attivi, pianificati e ricorrenti con prossimo run, ultimo run, durata, stato, agente owner." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="865" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="vis2" value="Stop / pause / resume&#xa;&#xa;Ogni job lungo deve avere pulsante stop. I job ricorrenti devono poter essere messi in pausa senza perdere configurazione." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="865" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="vis3" value="Parametri salvati&#xa;&#xa;Profili, nomi, soglie, intervalli, webhook e browser profile devono restare visibili e modificabili." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="865" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="vis4" value="Alert non fatali&#xa;&#xa;Login mancante, snapshot incompleto, pagina non trovata e Discord error devono comparire senza far fallire job sani." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1170" y="865" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cron-title" value="Cron model" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="1035" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cron-box" value="minute hour day month weekday&#xa;&#xa;Esempi visuali:&#xa;• 0 8 * * * = ogni giorno alle 08:00&#xa;• */30 * * * * = ogni 30 minuti&#xa;• 0 9 * * 1-5 = giorni feriali alle 09:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101828;strokeColor=#101828;fontColor=#FFFFFF;fontSize=14;fontFamily=Menlo,Consolas,monospace;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="1080" width="780" height="95" as="geometry" />
        </mxCell>
        <mxCell id="safety-box" value="Regola architetturale&#xa;&#xa;Un job ricorrente non deve mai diventare invisibile: deve avere owner, prossimo run, ultimo output, pulsante stop e stato nel gioco + notifica se bloccato." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#D92D20;fontSize=14;fontStyle=1;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="1060" width="600" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="media-runpod-visibility" name="Media &amp; RunPod">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="m-title" value="Media infrastructure · RunPod + ComfyUI" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="880" height="44" as="geometry" /></mxCell>
        <mxCell id="m-subtitle" value="Flusso separato dal marketplace: il media viene caricato nel Pod, il workflow API viene scelto e il job parte soltanto con Queue Workflow. Il gioco segue prompt ID, history, preview e download." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#667085;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="42" y="78" width="1180" height="48" as="geometry" /></mxCell>

        <mxCell id="m-lane-game" value="1. Gioco · RunPod Manager" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#F7FAFF;strokeColor=#CBD5E1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="350" height="690" as="geometry" /></mxCell>
        <mxCell id="m-lane-pod" value="2. GPU cloud · Pod + ComfyUI" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#FBF8FF;strokeColor=#CBD5E1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="155" width="420" height="690" as="geometry" /></mxCell>
        <mxCell id="m-lane-output" value="3. Job history · output" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#F7FFFB;strokeColor=#CBD5E1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="890" y="155" width="360" height="690" as="geometry" /></mxCell>
        <mxCell id="m-lane-roadmap" value="4. Video preset layer · roadmap" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#FFFCF3;strokeColor=#CBD5E1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1290" y="155" width="470" height="690" as="geometry" /></mxCell>

        <mxCell id="m1" value="RunPod Manager agent&#xa;&#xa;• API key resta nelle System Settings&#xa;• Stato Pod aggiornato&#xa;• GPU e Network Volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#2563EB;fontSize=13;spacing=10;" vertex="1" parent="m-lane-game"><mxGeometry x="30" y="65" width="290" height="110" as="geometry" /></mxCell>
        <mxCell id="m2" value="Workflow library&#xa;&#xa;• Wan 2.2 14B Image-to-Video&#xa;• SeedVR2 Video Enhance&#xa;• API JSON, non canvas JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=10;" vertex="1" parent="m-lane-game"><mxGeometry x="30" y="220" width="290" height="115" as="geometry" /></mxCell>
        <mxCell id="m3" value="Input controllato&#xa;&#xa;Carica foto o video, poi seleziona esplicitamente il nodo LoadImage / LoadVideo da sostituire." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#2563EB;fontSize=13;spacing=10;" vertex="1" parent="m-lane-game"><mxGeometry x="30" y="380" width="290" height="115" as="geometry" /></mxCell>
        <mxCell id="m4" value="Queue Workflow&#xa;&#xa;Unico punto che avvia il job. Upload media ≠ generazione." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#D92D20;fontSize=13;fontStyle=1;spacing=10;" vertex="1" parent="m-lane-game"><mxGeometry x="30" y="540" width="290" height="100" as="geometry" /></mxCell>

        <mxCell id="m5" value="Pod + Network Volume&#xa;&#xa;• GPU selezionata nella regione del volume&#xa;• ComfyUI porta 8188&#xa;• Health check prima dell'uso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=10;" vertex="1" parent="m-lane-pod"><mxGeometry x="40" y="75" width="340" height="120" as="geometry" /></mxCell>
        <mxCell id="m6" value="ComfyUI input&#xa;&#xa;Il media viene caricato in input. Il nome restituito viene iniettato solo nel loader selezionato." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=10;" vertex="1" parent="m-lane-pod"><mxGeometry x="40" y="245" width="340" height="115" as="geometry" /></mxCell>
        <mxCell id="m7" value="POST /prompt&#xa;&#xa;Workflow API + loader aggiornato → prompt_id. ComfyUI esegue modelli e salva output sul volume." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#B7791F;fontSize=13;spacing=10;" vertex="1" parent="m-lane-pod"><mxGeometry x="40" y="415" width="340" height="115" as="geometry" /></mxCell>

        <mxCell id="m8" value="Prompt ID + polling&#xa;&#xa;Il gioco conserva il job e legge /history ogni 3 secondi finché ComfyUI completa o fallisce." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F2;strokeColor=#0F9F6E;fontSize=13;spacing=10;" vertex="1" parent="m-lane-output"><mxGeometry x="30" y="110" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="m9" value="Preview + download&#xa;&#xa;Immagine/video generato visibile nel gioco e apribile/scaricabile dal proxy ComfyUI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F2;strokeColor=#0F9F6E;fontSize=13;spacing=10;" vertex="1" parent="m-lane-output"><mxGeometry x="30" y="300" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="m10" value="Dati operativi&#xa;&#xa;Workflow, prompt_id, Pod, stato, file output e costo stimato devono restare analizzabili." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=10;" vertex="1" parent="m-lane-output"><mxGeometry x="30" y="490" width="300" height="115" as="geometry" /></mxCell>

        <mxCell id="m11" value="Foto → video prodotto&#xa;&#xa;Movimento leggero, prodotto accurato, composizione verticale e nessun testo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#B7791F;fontSize=13;spacing=10;" vertex="1" parent="m-lane-roadmap"><mxGeometry x="35" y="70" width="400" height="105" as="geometry" /></mxCell>
        <mxCell id="m12" value="Foto → storia&#xa;&#xa;Preset 9:16 con mood, durata, progressione visiva e output pronto per pubblicazione." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#B7791F;fontSize=13;spacing=10;" vertex="1" parent="m-lane-roadmap"><mxGeometry x="35" y="220" width="400" height="105" as="geometry" /></mxCell>
        <mxCell id="m13" value="Foto → Reel / social&#xa;&#xa;Hook visuale, mano/modella opzionale, stile e CTA gestiti senza esporre il JSON." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#B7791F;fontSize=13;spacing=10;" vertex="1" parent="m-lane-roadmap"><mxGeometry x="35" y="370" width="400" height="105" as="geometry" /></mxCell>
        <mxCell id="m14" value="Contratto di ogni preset&#xa;&#xa;workflow · tipo media · loader · prompt controllabili · formato · costo stimato · output atteso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#D92D20;fontSize=13;fontStyle=1;spacing=10;" vertex="1" parent="m-lane-roadmap"><mxGeometry x="35" y="530" width="400" height="105" as="geometry" /></mxCell>

        <mxCell id="me1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2563EB;endArrow=block;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2563EB;endArrow=block;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#D92D20;endArrow=block;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7C3AED;endArrow=block;" edge="1" parent="1" source="m1" target="m5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7C3AED;endArrow=block;" edge="1" parent="1" source="m3" target="m6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B7791F;endArrow=block;" edge="1" parent="1" source="m4" target="m7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#0F9F6E;endArrow=block;" edge="1" parent="1" source="m7" target="m8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#0F9F6E;endArrow=block;" edge="1" parent="1" source="m8" target="m9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7C3AED;endArrow=block;" edge="1" parent="1" source="m9" target="m10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B7791F;endArrow=block;dashed=1;" edge="1" parent="1" source="m2" target="m11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B7791F;endArrow=block;dashed=1;" edge="1" parent="1" source="m11" target="m12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B7791F;endArrow=block;dashed=1;" edge="1" parent="1" source="m12" target="m13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#D92D20;endArrow=block;dashed=1;" edge="1" parent="1" source="m13" target="m14"><mxGeometry relative="1" as="geometry" /></mxCell>
