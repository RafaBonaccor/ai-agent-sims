        <mxCell id="n1" value="Start monitor&#xa;&#xa;• Lista profili salvati&#xa;• Nome profilo + URL&#xa;• Intervallo umano" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#2563EB;fontSize=13;spacing=10;" vertex="1" parent="lane-config">
          <mxGeometry x="24" y="70" width="212" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Parametri normalizzati&#xa;&#xa;• URL multipli separati&#xa;• 0 = una volta&#xa;• &gt;0 = ciclo continuo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#2563EB;fontSize=13;spacing=10;" vertex="1" parent="lane-config">
          <mxGeometry x="24" y="230" width="212" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Job gateway&#xa;&#xa;• timeout = none per monitor&#xa;• stop manuale disponibile&#xa;• log eventi job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#2563EB;fontSize=13;spacing=10;" vertex="1" parent="lane-config">
          <mxGeometry x="24" y="390" width="212" height="105" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="Apri / riusa browser&#xa;&#xa;• Profilo persistente&#xa;• Tab dedicata&#xa;• Sessione già loggata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F2;strokeColor=#0F9F6E;fontSize=13;spacing=10;" vertex="1" parent="lane-browser">
          <mxGeometry x="24" y="70" width="212" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Controlli pagina&#xa;&#xa;• Page not found&#xa;• Marker accesso&#xa;• Cookie/banner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F2;strokeColor=#0F9F6E;fontSize=13;spacing=10;" vertex="1" parent="lane-browser">
          <mxGeometry x="24" y="230" width="212" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Scroll totale profilo&#xa;&#xa;• Arriva al fondo&#xa;• Attende lazy-load&#xa;• Verifica round stabili" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F2;strokeColor=#0F9F6E;fontSize=13;spacing=10;" vertex="1" parent="lane-browser">
          <mxGeometry x="24" y="390" width="212" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Verifica finale scroll&#xa;&#xa;• 3 controlli extra&#xa;• Rilegge grid&#xa;• Evita acquisizione corta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F2;strokeColor=#0F9F6E;fontSize=13;spacing=10;" vertex="1" parent="lane-browser">
          <mxGeometry x="24" y="550" width="212" height="105" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="Estrai articoli correnti&#xa;&#xa;• item_id&#xa;• link&#xa;• titolo&#xa;• prezzo&#xa;• immagine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#B7791F;fontSize=13;spacing=10;" vertex="1" parent="lane-extract">
          <mxGeometry x="24" y="70" width="212" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Normalizza identità&#xa;&#xa;• profile_url&#xa;• member_id&#xa;• deduplica link&#xa;• timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#B7791F;fontSize=13;spacing=10;" vertex="1" parent="lane-extract">
          <mxGeometry x="24" y="240" width="212" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="Dettaglio articolo opzionale&#xa;&#xa;Solo quando serve per scoring: descrizione, data caricamento, spedizione, like, prezzo totale." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#B7791F;fontSize=13;spacing=10;" vertex="1" parent="lane-extract">
          <mxGeometry x="24" y="400" width="212" height="125" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="Snapshot sembra completo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;fontStyle=1;spacing=8;" vertex="1" parent="lane-score">
          <mxGeometry x="42" y="66" width="176" height="112" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="Protezione anti falsi spariti&#xa;&#xa;Se la nuova lettura è molto più piccola della precedente: snapshot incompleto, nessun articolo marcato sparito." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#D92D20;fontSize=13;spacing=10;" vertex="1" parent="lane-score">
          <mxGeometry x="24" y="230" width="212" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="Classifica articoli&#xa;&#xa;• new&#xa;• still_active&#xa;• gone&#xa;• current" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=10;" vertex="1" parent="lane-score">
          <mxGeometry x="24" y="410" width="212" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="Scoring affari&#xa;&#xa;• like minimi&#xa;• età massima&#xa;• prezzo min/max&#xa;• spedizione max&#xa;• offerta già inviata?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=10;" vertex="1" parent="lane-score">
          <mxGeometry x="24" y="570" width="212" height="125" as="geometry" />
        </mxCell>

        <mxCell id="n14" value="DB snapshot profilo&#xa;&#xa;Salva solo snapshot affidabili come baseline per il prossimo confronto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=10;" vertex="1" parent="lane-db">
          <mxGeometry x="24" y="70" width="212" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="Storico articolo&#xa;&#xa;• first_seen&#xa;• last_seen&#xa;• sold_after&#xa;• stato ultimo ciclo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=10;" vertex="1" parent="lane-db">
          <mxGeometry x="24" y="230" width="212" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="Storico azioni&#xa;&#xa;• offerte inviate&#xa;• like applicati&#xa;• notifiche mandate&#xa;• bozze upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=10;" vertex="1" parent="lane-db">
          <mxGeometry x="24" y="390" width="212" height="105" as="geometry" />
        </mxCell>

        <mxCell id="n17" value="Report Discord&#xa;&#xa;• attivi&#xa;• nuovi&#xa;• spariti&#xa;• avviso snapshot incompleto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#D92D20;fontSize=13;spacing=10;" vertex="1" parent="lane-actions">
          <mxGeometry x="34" y="70" width="232" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="Notifiche gioco&#xa;&#xa;Toast + job notifications + messaggio agente assegnato." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#D92D20;fontSize=13;spacing=10;" vertex="1" parent="lane-actions">
          <mxGeometry x="34" y="240" width="232" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="Azioni su articolo&#xa;&#xa;• like su affare&#xa;• offerta calcolata su prezzo base&#xa;• skip se pulsante assente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#D92D20;fontSize=13;spacing=10;" vertex="1" parent="lane-actions">
          <mxGeometry x="34" y="400" width="232" height="115" as="geometry" />
