        <mxCell id="subtitle" value="Flusso visuale stile draw.io: monitor profili, acquisizione articoli, scoring, notifiche, offerte e upload. Il primo controllo parte subito; i cicli successivi seguono l'intervallo configurato." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#667085;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
