        <mxCell id="state-title" value="Tabella stati principali" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="300" height="28" as="geometry" />
        </mxCell>
        <mxCell id="table-head" value="Stato | Quando succede | Effetto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101828;strokeColor=#101828;fontColor=#FFFFFF;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="970" width="860" height="36" as="geometry" />
        </mxCell>
        <mxCell id="table-new" value="new | Presente ora, assente nello snapshot precedente | Notifica come nuovo e salva first_seen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F2;strokeColor=#CBD5E1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1006" width="860" height="44" as="geometry" />
        </mxCell>
        <mxCell id="table-still" value="still_active | Presente ora e già visto prima | Aggiorna last_seen senza alert inutile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#CBD5E1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1050" width="860" height="44" as="geometry" />
        </mxCell>
        <mxCell id="table-gone" value="gone | Presente prima, assente ora, ma solo con snapshot completo | Segna venduto/rimosso e calcola sold_after" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#CBD5E1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1094" width="860" height="44" as="geometry" />
        </mxCell>
        <mxCell id="table-incomplete" value="incomplete | Nuova lettura molto più piccola del precedente | Non salva baseline, zero spariti, manda warning" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#CBD5E1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1138" width="860" height="44" as="geometry" />
        </mxCell>

        <mxCell id="rules-title" value="Regole chiave" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="980" y="930" width="260" height="28" as="geometry" />
        </mxCell>
        <mxCell id="rule-1" value="Primo ciclo sempre immediato. L'intervallo controlla solo la pausa prima del ciclo successivo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="970" width="700" height="48" as="geometry" />
        </mxCell>
        <mxCell id="rule-2" value="Uno snapshot incompleto non può generare articoli spariti: evita falsi venduti quando lo scroll legge solo 20 invece di 60." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="1030" width="700" height="48" as="geometry" />
        </mxCell>
        <mxCell id="rule-3" value="Le azioni automatiche sono sempre idempotenti: se offerta/notifica/like risultano già registrati, vengono saltati." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="1090" width="700" height="48" as="geometry" />
        </mxCell>
      </root>
