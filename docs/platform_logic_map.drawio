  <diagram id="visual-intelligence" name="Visual Intelligence">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v-title" value="Visual Intelligence · domanda basata su vendite reali" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1000" height="44" as="geometry" /></mxCell>
        <mxCell id="v-subtitle" value="Il modello vision trova somiglianze; il database storico attribuisce il significato commerciale. Prima validazione offline, poi eventuale influenza sui segnali di affare." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#667085;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="42" y="78" width="1280" height="42" as="geometry" /></mxCell>

        <mxCell id="v-lane-source" value="1. Dati verificati" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#F7FAFF;strokeColor=#CBD5E1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="330" height="715" as="geometry" /></mxCell>
        <mxCell id="v-lane-worker" value="2. Worker asincrono" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#F7FFFB;strokeColor=#CBD5E1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="405" y="155" width="350" height="715" as="geometry" /></mxCell>
        <mxCell id="v-lane-retrieval" value="3. Comparabili + score" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#FBF8FF;strokeColor=#CBD5E1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="790" y="155" width="390" height="715" as="geometry" /></mxCell>
        <mxCell id="v-lane-proof" value="4. Validazione e scala" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#FFFCF3;strokeColor=#CBD5E1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1215" y="155" width="520" height="715" as="geometry" /></mxCell>

        <mxCell id="v1" value="Annunci + foto archiviate&#xa;&#xa;listing ID · hash foto · categoria · keyword · prezzo · like · seller · timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#2563EB;fontSize=13;spacing=11;" vertex="1" parent="v-lane-source"><mxGeometry x="30" y="75" width="270" height="125" as="geometry" /></mxCell>
        <mxCell id="v2" value="Esito commerciale verificato&#xa;&#xa;venduto / attivo / rimosso · ore alla vendita · prezzo finale · snapshot e prove" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=11;" vertex="1" parent="v-lane-source"><mxGeometry x="30" y="265" width="270" height="115" as="geometry" /></mxCell>
        <mxCell id="v3" value="Coda persistente&#xa;&#xa;Nuove immagini sono accodate. Il monitoraggio non aspetta l'analisi vision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F2;strokeColor=#0F9F6E;fontSize=13;spacing=11;" vertex="1" parent="v-lane-source"><mxGeometry x="30" y="445" width="270" height="105" as="geometry" /></mxCell>

        <mxCell id="v4" value="Embedding CLIP / OpenCLIP&#xa;&#xa;Foto → vettore normalizzato. Descrive somiglianza visiva, non domanda o convenienza." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F2;strokeColor=#0F9F6E;fontSize=13;spacing=11;" vertex="1" parent="v-lane-worker"><mxGeometry x="30" y="105" width="290" height="120" as="geometry" /></mxCell>
        <mxCell id="v5" value="Persistenza embeddings&#xa;&#xa;listing ID · nome/modello · versione · vettore · immagine hash · creato il" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=11;" vertex="1" parent="v-lane-worker"><mxGeometry x="30" y="290" width="290" height="105" as="geometry" /></mxCell>
        <mxCell id="v6" value="Esecuzione graduale&#xa;&#xa;MVP: CPU locale in batch. Backlog: GPU RunPod temporanea. Mai GPU sempre attiva senza necessità." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#B7791F;fontSize=13;spacing=11;" vertex="1" parent="v-lane-worker"><mxGeometry x="30" y="465" width="290" height="115" as="geometry" /></mxCell>

        <mxCell id="v7" value="Ricerca dei comparabili&#xa;&#xa;Top-K prodotti visivamente vicini filtrati per categoria, prezzo, periodo e stato." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFF;strokeColor=#7C3AED;fontSize=13;spacing=11;" vertex="1" parent="v-lane-retrieval"><mxGeometry x="35" y="100" width="320" height="115" as="geometry" /></mxCell>
        <mxCell id="v8" value="Score spiegabile&#xa;&#xa;Velocità vendita simili + prezzo relativo + like/età + dimensione/qualità campione." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#B7791F;fontSize=13;spacing=11;" vertex="1" parent="v-lane-retrieval"><mxGeometry x="35" y="280" width="320" height="115" as="geometry" /></mxCell>
        <mxCell id="v9" value="Output nel report&#xa;&#xa;Visual demand score · comparabili · vendite 6h/24h/72h · mediana · spiegazione · attendibilità" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#D92D20;fontSize=13;fontStyle=1;spacing=11;" vertex="1" parent="v-lane-retrieval"><mxGeometry x="35" y="460" width="320" height="120" as="geometry" /></mxCell>

        <mxCell id="v10" value="Backtest obbligatorio&#xa;&#xa;Usa solo informazioni disponibili alla scoperta. Confronta score con esito reale: venduto in 6h, 24h, 72h o lento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6DB;strokeColor=#B7791F;fontSize=13;spacing=11;" vertex="1" parent="v-lane-proof"><mxGeometry x="35" y="80" width="450" height="125" as="geometry" /></mxCell>
        <mxCell id="v11" value="Regola di rilascio&#xa;&#xa;Finché non migliora metriche rispetto a prezzo + like + età + keyword, resta analisi e NON determina alert o offerte." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#D92D20;fontSize=13;fontStyle=1;spacing=11;" vertex="1" parent="v-lane-proof"><mxGeometry x="35" y="260" width="450" height="115" as="geometry" /></mxCell>
        <mxCell id="v12" value="Crescita controllata&#xa;&#xa;SQLite + ricerca locale → vector index → Qdrant solo con volume e latenza che lo giustificano. Modello ML commerciale soltanto dopo molti esiti puliti." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FF;strokeColor=#2563EB;fontSize=13;spacing=11;" vertex="1" parent="v-lane-proof"><mxGeometry x="35" y="440" width="450" height="135" as="geometry" /></mxCell>

        <mxCell id="ve1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2563EB;endArrow=block;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ve2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#0F9F6E;endArrow=block;" edge="1" parent="1" source="v1" target="v3"><mxGeometry relative="1" as="geometry" /></mxCell>
